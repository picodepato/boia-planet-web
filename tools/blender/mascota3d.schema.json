{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boia-planet/tools/blender/mascota3d.schema.json",
  "title": "Manifiesto de las mascotas de Blender del barco del mar 3D (art/mascotas/3d/manifest.json)",
  "description": "Lo escribe tools/blender/export_mascotas_glb.py y lo valida tools/blender/check.py (check_mascotas_3d); /mar lo lee (apps/web/app/mar/engine/mascot-models.ts). Cada pieza es un nodo del GLB con su pivote (traslación, glTF: y arriba).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "nota", "unidades", "max_tris", "mascotas"],
  "properties": {
    "status": {"enum": ["muestra", "aprobada"]},
    "nota": {"type": "string", "minLength": 1},
    "unidades": {"type": "string", "minLength": 1},
    "max_tris": {"type": "integer", "minimum": 1},
    "mascotas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "label", "length", "height", "parts", "tris", "kb", "doc"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "file": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.glb$"},
          "label": {"type": "string", "minLength": 1},
          "length": {"type": "number", "minimum": 0},
          "height": {"type": "number", "minimum": 0},
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "pivot", "tris"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "pivot": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                "tris": {"type": "integer", "minimum": 1}
              }
            }
          },
          "tris": {"type": "integer", "minimum": 1},
          "kb": {"type": "integer", "minimum": 1},
          "doc": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
