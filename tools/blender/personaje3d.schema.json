{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boia-planet/tools/blender/personaje3d.schema.json",
  "title": "Manifiesto de los personajes del agua de Blender del mar 3D (art/personajes/3d/manifest.json; plan 029 T270)",
  "description": "Lo escribe tools/blender/export_mascotas_glb.py --kind personajes y lo valida tools/blender/check.py (check_personajes_3d); /mar lo lee (apps/web/app/mar/engine/mascot-models.ts, CHARACTER_MODELS). Cada pieza es un nodo del GLB con su pivote (traslación, glTF: y arriba).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "nota", "unidades", "max_tris", "personajes"],
  "properties": {
    "status": {"enum": ["muestra", "aprobada"]},
    "nota": {"type": "string", "minLength": 1},
    "unidades": {"type": "string", "minLength": 1},
    "max_tris": {"type": "integer", "minimum": 1},
    "personajes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "label", "length", "height", "parts", "tris", "kb", "doc"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "file": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.glb$"},
          "label": {"type": "string", "minLength": 1},
          "length": {"type": "number", "minimum": 0},
          "height": {"type": "number", "minimum": 0},
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "pivot", "tris"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "pivot": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                "tris": {"type": "integer", "minimum": 1}
              }
            }
          },
          "tris": {"type": "integer", "minimum": 1},
          "kb": {"type": "integer", "minimum": 1},
          "doc": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
