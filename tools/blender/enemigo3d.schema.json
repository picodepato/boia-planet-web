{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boia-planet/tools/blender/enemigo3d.schema.json",
  "title": "Manifiesto de los enemigos de Blender del mar 3D (art/enemigos/3d/manifest.json)",
  "description": "Lo escribe tools/blender/export_enemigos_glb.py y lo valida tools/blender/check.py (check_enemigos_3d); /mar lo lee (apps/web/app/mar/engine/enemy-models.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "nota", "unidades", "max_tris", "enemigos"],
  "properties": {
    "status": {"enum": ["muestra", "aprobada"]},
    "nota": {"type": "string", "minLength": 1},
    "unidades": {"type": "string", "minLength": 1},
    "max_tris": {"type": "integer", "minimum": 1},
    "enemigos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "label", "radius", "length", "height", "tris", "kb", "doc"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "file": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.glb$"},
          "label": {"type": "string", "minLength": 1},
          "radius": {"type": "number", "minimum": 0.1},
          "length": {"type": "number", "minimum": 0},
          "height": {"type": "number", "minimum": 0},
          "tris": {"type": "integer", "minimum": 1},
          "kb": {"type": "integer", "minimum": 1},
          "doc": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
