{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boia-planet/tools/blender/landing3d.schema.json",
  "title": "Manifest of the landing hero props from Blender (art/landing/3d/manifest.json)",
  "description": "Written by tools/blender/landing/export_landing_glb.py and validated by tools/blender/check.py (check_landing_3d); T79's loader reads it. Units: metres, glTF axes (y up, -z seaward).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "nota", "unidades", "max_tris", "max_kb", "total_tris", "total_kb", "escena", "props"],
  "properties": {
    "status": {"enum": ["muestra", "aprobada"]},
    "nota": {"type": "string", "minLength": 1},
    "unidades": {"type": "string", "minLength": 1},
    "max_tris": {"type": "integer", "minimum": 1},
    "max_kb": {"type": "integer", "minimum": 1},
    "total_tris": {"type": "integer", "minimum": 1},
    "total_kb": {"type": "integer", "minimum": 1},
    "escena": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "props", "sun", "moon", "nota"],
      "properties": {
        "camera": {
          "type": "object",
          "required": ["position", "pitch_deg", "fov_vertical_deg", "aspect", "focus"],
          "properties": {
            "position": {"$ref": "#/$defs/xyz"},
            "pitch_deg": {"type": "number"},
            "fov_vertical_deg": {"type": "number", "minimum": 1},
            "aspect": {"type": "number", "minimum": 0.1},
            "focus": {"type": "string"}
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "yaw_deg"],
            "properties": {"position": {"$ref": "#/$defs/xyz"}, "yaw_deg": {"type": "number"}}
          }
        },
        "sun": {"$ref": "#/$defs/skypoint"},
        "moon": {"$ref": "#/$defs/skypoint"},
        "nota": {"type": "string"}
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "label", "doc", "anchor", "scale", "height", "bounds", "tris", "budget_tris",
                     "kb", "budget_kb", "materials", "normals", "lights"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "file": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.glb$"},
          "label": {"type": "string", "minLength": 1},
          "doc": {"type": "string", "minLength": 1},
          "anchor": {"type": "string", "minLength": 1},
          "scale": {"type": "number", "minimum": 0.001},
          "height": {"type": "number", "minimum": 0},
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {"min": {"$ref": "#/$defs/xyz"}, "max": {"$ref": "#/$defs/xyz"}}
          },
          "tris": {"type": "integer", "minimum": 1},
          "budget_tris": {"type": "integer", "minimum": 1},
          "kb": {"type": "integer", "minimum": 1},
          "budget_kb": {"type": "integer", "minimum": 1},
          "materials": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
          "normals": {"type": "string", "minLength": 1},
          "lights": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node", "color", "position"],
              "properties": {
                "node": {"type": "string", "pattern": "^luz_[a-z0-9_]+$"},
                "color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
                "position": {"$ref": "#/$defs/xyz"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "skypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azimuth_deg", "elevation_deg"],
      "properties": {"azimuth_deg": {"type": "number"}, "elevation_deg": {"type": "number"}}
    }
  }
}
