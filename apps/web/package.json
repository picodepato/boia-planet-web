{
  "name": "@boia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-art.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "build": "node scripts/copy-art.mjs && next build && node scripts/landing-budget.mjs",
    "art:copy": "node scripts/copy-art.mjs",
    "i18n:zonas": "node scripts/i18n-zonas.mjs",
    "budget": "node scripts/landing-budget.mjs",
    "pwa:icons": "node scripts/pwa-icons.mjs",
    "e2e": "playwright test",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "cf:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local && node scripts/cf-assets.mjs",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:measure": "node scripts/cf-measure.mjs"
  },
  "dependencies": {
    "@boia/contracts": "workspace:*",
    "@boia/db": "workspace:*",
    "@boia/engine": "workspace:*",
    "@boia/store": "workspace:*",
    "@boia/world": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "jsqr": "1.4.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.63.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "pngjs": "7.0.0",
    "wrangler": "4.149.0"
  }
}
