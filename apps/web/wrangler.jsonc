// Worker de Cloudflare de la web pública (plan 027 T262). Lo construye
// `pnpm cf:build` (@opennextjs/cloudflare) desde la misma salida de
// `next build` que despliega Vercel; `pnpm cf:preview` lo sirve en local con
// `wrangler dev` y `pnpm cf:measure` mide su tamaño. Desplegar, dominio y
// cuenta son cosa de Álvaro (docs/DESPLIEGUE.md, T265).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boia-planet",
  // La entrada (plan 046 T326): el Worker de OpenNext (`.open-next/worker.js`)
  // más los rangos (`Range`) de los vídeos y audios, que los archivos
  // estáticos de Cloudflare no atienden (scripts/cf-range.mjs).
  "main": "cf-worker.mjs",
  // La más nueva que entiende el workerd de wrangler 4.149 (1.20261006): una
  // fecha posterior hace fallar `wrangler dev` en local. Súbase con wrangler.
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Archivos estáticos (`public/`, `/_next/static`): Cloudflare los sirve sin
  // pasar por el Worker, sin cuota de peticiones. Sus cabeceras van en el
  // `_headers` y `_redirects` que escribe scripts/cf-assets.mjs tras construir.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Los vídeos y audios pasan primero por el Worker, que responde `206` a
    // las peticiones con `Range` (sin ello Chrome no puede saltar, repetir ni
    // reanudar la descarga). Los mismos patrones que `MEDIA_RUN_WORKER_FIRST`
    // de scripts/cf-range.mjs; lo demás no gasta peticiones del Worker.
    "run_worker_first": ["/*.mp4", "/*.webm", "/*.mp3", "/*.m4a", "/*.ogg"],
  },
  // Registros del Worker en el panel (gratis con límite diario).
  "observability": { "enabled": true },
}
