# BOIA.PLANET · variables de entorno (T49, REQ-ARQ-024)
#
# La versión de prueba (D-20) NO necesita ninguna: `pnpm build`, `pnpm dev` y
# el despliegue en Vercel funcionan con el entorno vacío. Todo lo de abajo es
# opcional. Para usar alguna en local, copia este archivo a
# `apps/web/.env.local` (Next lo lee de ahí; está en .gitignore) y descomenta.
# Nunca pongas claves reales en este archivo ni en el repo.

# --- Analítica (REQ-ARQ-019) -------------------------------------------------
# Sin clave no sale ninguna petición: los eventos sólo se apuntan en
# window.__boiaAnalytics. Con clave, se mandan a PostHog.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Desarrollo --------------------------------------------------------------
# Puerto de `pnpm demo` (el 3000 es el de `pnpm dev`).
# PORT=3100
# Puerto del servidor de las e2e (`pnpm e2e`); por defecto 3107.
# E2E_PORT=3107
# Abre /sphere-probe (sonda del planeta, sólo para pruebas visuales).
# BOIA_SPHERE_PROBE=1

# --- Base de datos de pruebas (packages/db, `pnpm db:test`) ------------------
# Postgres local para las pruebas de RLS de la versión final (Supabase).
# BOIA_PG_URL=postgresql://localhost:5432/postgres

# --- Grabaciones y capturas de las e2e (sólo a mano) -------------------------
# RECORD_DEMO=1
# RECORD_INTRO=1
# RECORD_TITLE=1
# RECORD_MARCA=1
# RECORD_AGUJERO=1
# RECORD_T43=1   (y RECORD_T44…T47: capturas de cada encargo)
# DEMO_SHOTS=1
# LOGROS_SHOTS=1

# --- Versión final (todavía no existe, D-20) ---------------------------------
# Cuando lleguen Supabase, el correo y la ticketera, sus claves van en el
# panel de Vercel (Environment Variables), nunca aquí:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
