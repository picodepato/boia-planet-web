# BOIA.PLANET · variables de entorno (T49, REQ-ARQ-024)
#
# La versión de prueba (D-20) NO necesita ninguna: `pnpm build`, `pnpm dev` y
# el despliegue en Vercel funcionan con el entorno vacío. Todo lo de abajo es
# opcional. Para usar alguna en local, copia este archivo a
# `apps/web/.env.local` (Next lo lee de ahí; está en .gitignore) y descomenta.
# Nunca pongas claves reales en este archivo ni en el repo.

# --- Analítica (REQ-ARQ-019) -------------------------------------------------
# Sin clave no sale ninguna petición: los eventos sólo se apuntan en
# window.__boiaAnalytics. Con clave, se mandan a PostHog.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Desarrollo --------------------------------------------------------------
# Puerto de `pnpm demo` (el 3000 es el de `pnpm dev`).
# PORT=3100
# Puerto del servidor de las e2e (`pnpm e2e`); por defecto 3107.
# E2E_PORT=3107

# --- Base de datos de pruebas (packages/db, `pnpm db:test`) ------------------
# Postgres local para las pruebas de RLS de la versión final (Supabase).
# BOIA_PG_URL=postgresql://localhost:5432/postgres

# --- Grabaciones y capturas de las e2e (sólo a mano) -------------------------
# RECORD_DEMO=1
# RECORD_INTRO=1
# RECORD_TITLE=1
# RECORD_MARCA=1
# RECORD_AGUJERO=1
# RECORD_T43=1   (y RECORD_T44…T47: capturas de cada encargo)
# DEMO_SHOTS=1
# LOGROS_SHOTS=1

# --- Supabase (plan 008, README «Cuentas con Supabase») ---------------------
# Sin estas variables la web sigue en modo local (D-20): todo en el
# navegador, como en producción hoy. Con ellas, las cuentas por email y lo de
# valor van a Supabase. En desarrollo van en apps/web/.env.local (proyecto
# boia-planet-dev). En Vercel sólo las dos NEXT_PUBLIC_ (las del proyecto de
# producción, y volver a desplegar); la clave secreta y SUPABASE_DB_URL sólo
# las usan los scripts, nunca Vercel ni el navegador. Nunca en el repo.
# Lista de producción: docs/propuestas/2026-10-03-produccion-supabase.md.
# Los scripts leen primero la terminal y después apps/web/.env.local:
#   pnpm db:migrate:dev   aplica supabase/migrations y la muestra al proyecto
#                         (se niega si SUPABASE_DB_URL es de otro proyecto;
#                         -- --no-seed: sólo migraciones)
#   pnpm db:types:dev     regenera packages/db/src/database.types.ts
#   pnpm test:supabase    pruebas de integración (sin variables: se omiten);
#                         sólo contra desarrollo: crea y borra cuentas
#   E2E_SUPABASE=1 pnpm e2e <specs>   e2e con Supabase (sin él, modo local)
#   pnpm admin:grant -- <email> <owner|admin|editor|none>   rol del Admin
#   pnpm db:clean-test-users [-- --all]   borra cuentas @example.test viejas
# El correo (SMTP propio: Gmail para probar, Resend con el dominio para
# producción), las plantillas y las URL de Auth van en el panel de Supabase,
# no aquí.
# Project Settings -> Data API -> Project URL
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Project Settings -> API Keys -> publishable key (va al navegador)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API Keys -> secret key (sólo servidor y scripts)
# SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Session pooler (migraciones y pruebas SQL)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<contraseña>@<host>:5432/postgres

# --- Versión final (todavía no existe, D-20) ---------------------------------
# La ticketera, cuando llegue: sus claves van en el panel de Vercel
# (Environment Variables), nunca aquí.
